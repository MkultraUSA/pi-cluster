{
  "dashboard": {
    "uid": "pi-cluster-perf",
    "title": "Pi Cluster — Kubernetes & Container Performance",
    "tags": ["pi-cluster", "kubernetes"],
    "timezone": "home",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {"from": "now-6h", "to": "now"},
    "templating": {
      "list": [{
        "name": "node",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
        "query": {"query": "label_values(node_memory_MemTotal_bytes, instance)", "refId": "var"},
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }]
    },
    "panels": [
      {"id": 1, "type": "stat", "title": "Nodes Ready", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 1)", "refId": "A"}],
       "options": {"colorMode": "value", "graphMode": "none"},
       "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 4}]}}}},
      {"id": 2, "type": "stat", "title": "Pods on cluster", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "count(count by (pod) (container_memory_working_set_bytes{container!=\"\"}))", "refId": "A"}]},
      {"id": 3, "type": "stat", "title": "Scrape targets up", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "count(up{job=~\"cadvisor|kubelet|kube-state-metrics\"} == 1) / count(up{job=~\"cadvisor|kubelet|kube-state-metrics\"}) * 100", "refId": "A"}],
       "options": {"unit": "percent", "colorMode": "value", "graphMode": "none"}},
      {"id": 4, "type": "stat", "title": "CPU used / cluster", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\",instance=~\"$node\"}[5m]))", "refId": "A"}],
       "options": {"unit": "cores", "graphMode": "area"}},
      {"id": 10, "type": "timeseries", "title": "Node CPU %", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$node\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{instance}}"}],
       "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0, "custom": {"fillOpacity": 15}}, "overrides": []}},
      {"id": 11, "type": "timeseries", "title": "Node memory used %", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$node\"} / node_memory_MemTotal_bytes{instance=~\"$node\"})", "refId": "A", "legendFormat": "{{instance}}"}],
       "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0, "custom": {"fillOpacity": 15}}, "overrides": []}},
      {"id": 20, "type": "timeseries", "title": "Root disk used %", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{instance=~\"$node\",mountpoint=\"/\"} / node_filesystem_size_bytes{instance=~\"$node\",mountpoint=\"/\"})", "refId": "A", "legendFormat": "{{instance}}"}],
       "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0, "custom": {"fillOpacity": 15}}, "overrides": []}},
      {"id": 21, "type": "timeseries", "title": "Network in/out (bytes/s)", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [
         {"expr": "rate(node_network_receive_bytes_total{instance=~\"$node\",device!~\"lo\"}[$__rate_interval])", "refId": "A", "legendFormat": "rx {{instance}}"},
         {"expr": "rate(node_network_transmit_bytes_total{instance=~\"$node\",device!~\"lo\"}[$__rate_interval])", "refId": "B", "legendFormat": "tx {{instance}}"}],
       "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"fillOpacity": 10}}, "overrides": [{"matcher": {"id": "byName", "options": "tx cluster1"}, "properties": []}]}},
      {"id": 22, "type": "timeseries", "title": "Container restarts (24h)", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[24h]) > 0)", "refId": "A", "legendFormat": "{{namespace}}/{{pod}}"}],
       "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 15}}, "overrides": []}},
      {"id": 30, "type": "timeseries", "title": "Top pods by CPU (cores)", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 20},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "topk(8, sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\",instance=~\"$node\"}[5m])))", "refId": "A", "legendFormat": "{{namespace}}/{{pod}}"}],
       "fieldConfig": {"defaults": {"unit": "cores", "custom": {"fillOpacity": 15}}, "overrides": []}},
      {"id": 31, "type": "timeseries", "title": "Top pods by memory (working set)", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 20},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "topk(8, sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\",instance=~\"$node\"}))", "refId": "A", "legendFormat": "{{namespace}}/{{pod}}"}],
       "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 15}}, "overrides": []}},
      {"id": 40, "type": "piechart", "title": "Pods by state", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 29},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "sum by (phase) (kube_pod_status_phase{phase!=\"\"} > 0)", "refId": "A", "legendFormat": "{{phase}}"}],
       "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
       "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": [
         {"matcher": {"id": "byName", "options": "Running"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
         {"matcher": {"id": "byName", "options": "Pending"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]},
         {"matcher": {"id": "byName", "options": "Failed"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}]}},
      {"id": 41, "type": "timeseries", "title": "Deployments: available vs desired", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 29},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [
         {"expr": "sum(kube_deployment_status_replicas_available)", "refId": "A", "legendFormat": "available"},
         {"expr": "sum(kube_deployment_spec_replicas)", "refId": "B", "legendFormat": "desired"}],
       "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10}}, "overrides": []}},
      {"id": 42, "type": "timeseries", "title": "PVC usage %", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 29},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes", "refId": "A", "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}"}],
       "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0, "custom": {"fillOpacity": 10}}, "overrides": []}},
      {"id": 43, "type": "table", "title": "Node conditions", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 37},
       "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
       "targets": [{"expr": "max by (node, condition) (kube_node_status_condition{status=\"true\"})", "refId": "A", "instant": true, "format": "table"}],
       "transformations": [{"id": "organize", "options": {"renameByName": {"node": "Node", "condition": "Condition", "Value": "True?"}}}],
       "options": {"showHeader": true}}
    ]
  },
  "overwrite": true
}
